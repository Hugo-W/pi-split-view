{
	"name": "pi-split-view",
	"version": "1.3.1",
	"engines": {
		"node": ">=18.0.0"
	},
	"description": "Split-view TUI extension for the pi coding agent: thinking/tool band, files dock with edit-diff subpanel, response-only transcript mode",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hugo-W/pi-split-view.git"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"tui",
		"split-view",
		"panels"
	],
	"files": [
		"split-view.ts",
		"helpers.ts",
		"layout-manager.ts",
		"ui-panels-config.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"assets/screenshot-band-files.png",
		"assets/gallery-preview.png"
	],
	"pi": {
		"extensions": [
			"./split-view.ts"
		],
		"image": "https://raw.githubusercontent.com/Hugo-W/pi-split-view/main/assets/gallery-preview.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-tui": ">=1.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.6.3"
	}
}
